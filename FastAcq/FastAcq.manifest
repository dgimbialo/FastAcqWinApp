<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  DPI awareness (PerMonitorV2) is NOT declared here: the Manifest Tool adds
  the <windowsSettings> block itself (project setting "DPI Awareness =
  Per Monitor High DPI Aware", the MFC default is "High DPI Aware"). A second
  dpiAware element in this file would be merged into a duplicate, the
  activation context would fail to build and the executable would not start
  ("the application configuration is incorrect", error 14001).
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
